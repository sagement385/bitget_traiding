# Trading system credentials. Keep real values only in .env.
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Toss Securities adapter. Populate only with credentials and endpoint paths
# supplied through an approved Toss Securities API contract.
TOSS_API_BASE_URL=
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
TOSS_ALLOWED_IP=
TOSS_KOR_CANDLES_PATH=
TOSS_US_CANDLES_PATH=
TOSS_KOR_SYMBOLS_PATH=
TOSS_US_SYMBOLS_PATH=
TOSS_ACCOUNT_PATH=
TOSS_POSITIONS_PATH=
TOSS_ORDER_PATH=
TOSS_CANCEL_PATH=
TOSS_WS_URL=
TOSS_ACCESS_TOKEN=
TOSS_ACCOUNT_ID=

# Chungbuk flood disaster digital twin.
HRFCO_API_KEY=
KWATER_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
DATABASE_URL=
ENABLE_LLM=true
SAVE_API_SNAPSHOTS=true
STRICT_DATA_MODE=true

# Bitget Futures is the default UI surface. Enable other workloads explicitly.
ENABLE_STOCK_MARKETS=false
ENABLE_SURGE_SCANNER=false
